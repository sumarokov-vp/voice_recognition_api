# Движок распознавания: faster (Linux/NVIDIA, в docker) или mlx (Apple Silicon, нативно)
WHISPER_ENGINE=faster
WHISPER_LANGUAGE=ru

# Настройки движка faster (при WHISPER_ENGINE=mlx игнорируются)
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL_DIR=/models

# Настройки движка mlx (при WHISPER_ENGINE=faster игнорируются).
# Модель задаётся repo id на Hugging Face, кеш весов — в ~/.cache/huggingface
WHISPER_MLX_MODEL=mlx-community/whisper-large-v3-turbo

API_HOST=0.0.0.0
API_PORT=8000

MAX_FILE_SIZE_MB=1000

# Ключи потребителей: пары `имя:ключ` через запятую. Имя попадает в лог, ключ — никогда.
# Настоящие ключи живут в pass, в репозиторий не попадают.
API_KEYS=voice_input:CHANGE_ME

# UID/GID хоста для bind-mount ./data/models (чтобы файлы моделей принадлежали текущему пользователю)
HOST_UID=1000
HOST_GID=1000
